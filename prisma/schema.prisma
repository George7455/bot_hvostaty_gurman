generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

enum DraftStatus {
  NEW
  IN_REVIEW
  APPROVED
  PUBLISHED
}

enum SessionMode {
  IDLE
  WAITING_ARTICLE
  WAITING_NOTES
}

enum ModerationActionType {
  APPROVE
  REWRITE
  REWRITE_NOTES
}

enum DraftSourceType {
  SCHEDULED
  MANUAL_UPLOAD
}

enum ContentPlanStatus {
  IN_REVIEW
  PUBLISHED
}

enum PlannerRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum WorkflowJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  NEEDS_RECONCILIATION
}

model ContentPlanItem {
  id             String             @id @default(uuid())
  spreadsheetId  String?
  worksheetTitle String?
  sheetItemKey   String?
  sheetRowNumber Int
  topic          String
  rubric         String
  status         ContentPlanStatus?
  draftId        String?            @unique
  draft          Draft?             @relation(fields: [draftId], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([spreadsheetId, worksheetTitle, sheetItemKey])
  @@index([status, sheetRowNumber])
  @@index([spreadsheetId, worksheetTitle, sheetRowNumber])
}

model Draft {
  id                   String               @id @default(uuid())
  sourceType           DraftSourceType
  status               DraftStatus          @default(NEW)
  currentText          String
  currentRevisionNo    Int                  @default(0)
  currentRevisionId    String?              @unique
  currentRevision      DraftRevision?       @relation("CurrentDraftRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  approvedRevisionId   String?              @unique
  approvedRevision     DraftRevision?       @relation("ApprovedDraftRevision", fields: [approvedRevisionId], references: [id], onDelete: SetNull)
  approvedByActorId    String?
  approvedAt           DateTime?
  contentPlanItem      ContentPlanItem?
  revisions            DraftRevision[]      @relation("DraftRevisionHistory")
  moderationEvents     ModerationAction[]
  moderationDeliveries ModerationDelivery[]
  moderationMessages   ModerationMessage[]
  publicationIntents   PublicationIntent[]
  pendingInSessions    UserSession[]
  publication          Publication?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([status, updatedAt])
}

model DraftRevision {
  id                   String               @id @default(uuid())
  draftId              String
  draft                Draft                @relation("DraftRevisionHistory", fields: [draftId], references: [id], onDelete: Cascade)
  revisionNo           Int
  text                 String
  notes                String?
  currentForDraft      Draft?               @relation("CurrentDraftRevision")
  approvedForDraft     Draft?               @relation("ApprovedDraftRevision")
  moderationEvents     ModerationAction[]
  moderationDeliveries ModerationDelivery[]
  moderationMessages   ModerationMessage[]
  publicationIntents   PublicationIntent[]
  publication          Publication?
  pendingInSessions    UserSession[]
  createdAt            DateTime             @default(now())

  @@unique([draftId, revisionNo])
}

model ModerationAction {
  id         String               @id @default(uuid())
  draftId    String
  draft      Draft                @relation(fields: [draftId], references: [id], onDelete: Cascade)
  revisionId String?
  revision   DraftRevision?       @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  actionType ModerationActionType
  actorId    String
  notes      String?
  createdAt  DateTime             @default(now())
}

model UserSession {
  id                  String         @id @default(uuid())
  userId              String         @unique
  mode                SessionMode    @default(IDLE)
  pendingDraftId      String?
  pendingDraft        Draft?         @relation(fields: [pendingDraftId], references: [id], onDelete: SetNull)
  pendingRevisionId   String?
  pendingRevision     DraftRevision? @relation(fields: [pendingRevisionId], references: [id], onDelete: SetNull)
  processingToken     String?        @unique
  processingStartedAt DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([mode])
}

model Publication {
  id                String           @id @default(uuid())
  draftId           String           @unique
  draft             Draft            @relation(fields: [draftId], references: [id], onDelete: Cascade)
  revisionId        String?          @unique
  revision          DraftRevision?   @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  textSnapshot      String?
  publishedPayload  String?
  actorId           String?
  sourceType        DraftSourceType?
  telegramChatId    String
  telegramMessageId String
  telegraphPath     String?
  telegraphUrl      String?
  publishedAt       DateTime         @default(now())
}

model PlannerRun {
  id                String           @id @default(uuid())
  runKey            String           @unique
  status            PlannerRunStatus @default(PENDING)
  attempts          Int              @default(0)
  leaseToken        String?
  leaseExpiresAt    DateTime?
  lastError         String?
  contentPlanItemId String?
  draftId           String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status, leaseExpiresAt])
}

model ModerationDelivery {
  id             String              @id @default(uuid())
  draftId        String
  draft          Draft               @relation(fields: [draftId], references: [id], onDelete: Cascade)
  revisionId     String
  revision       DraftRevision       @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  status         WorkflowJobStatus   @default(PENDING)
  attempts       Int                 @default(0)
  leaseToken     String?
  leaseExpiresAt DateTime?
  lastError      String?
  sentAt         DateTime?
  messages       ModerationMessage[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([draftId, revisionId])
  @@index([status, leaseExpiresAt, createdAt])
}

model ModerationMessage {
  id                String             @id @default(uuid())
  deliveryId        String
  delivery          ModerationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  draftId           String
  draft             Draft              @relation(fields: [draftId], references: [id], onDelete: Cascade)
  revisionId        String
  revision          DraftRevision      @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  telegramChatId    String
  telegramMessageId String
  createdAt         DateTime           @default(now())

  @@unique([telegramChatId, telegramMessageId])
  @@unique([deliveryId, telegramChatId])
  @@index([draftId, revisionId])
}

model PublicationIntent {
  id              String            @id @default(uuid())
  draftId         String
  draft           Draft             @relation(fields: [draftId], references: [id], onDelete: Cascade)
  revisionId      String
  revision        DraftRevision     @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  status          WorkflowJobStatus @default(PENDING)
  attempts        Int               @default(0)
  leaseToken      String?
  leaseExpiresAt  DateTime?
  lastError       String?
  preparedPayload String?
  telegraphPath   String?
  telegraphUrl    String?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([draftId, revisionId])
  @@index([status, leaseExpiresAt, createdAt])
}
